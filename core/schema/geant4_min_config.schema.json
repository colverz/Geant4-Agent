{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Geant4MinimalConfigCompatibility",
  "type": "object",
  "required": ["geometry", "materials", "source", "run"],
  "properties": {
    "geometry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "structure": {"type": "string"},
        "params": {"type": "object"},
        "graph_program": {"type": "object"}
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "volume_material_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["volume", "material"],
            "properties": {
              "volume": {"type": "string"},
              "material": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "environment": {"type": "object", "additionalProperties": true}
      }
    },
    "physics_list": {
      "oneOf": [
        {"type": "string"},
        {"type": "object", "additionalProperties": true}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "particle": {"type": "string"},
        "energy_mev": {"type": "number"},
        "type": {"type": "string"}
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "events": {"type": "integer", "minimum": 1}
      }
    }
  },
  "additionalProperties": true
}
