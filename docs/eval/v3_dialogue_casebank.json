[
  {
    "id": "v3-design-only-then-payload",
    "lang": "en",
    "tags": ["design", "payload", "dialogue_quality"],
    "turns": [
      {
        "text": "Design a 1 MeV gamma lead shielding setup, do not run.",
        "expect": {
          "dialogue_act_in": ["design_presented", "needs_user_input"],
          "terminated_reason_in": ["final_answer", "waiting_user"],
          "has_payload": false,
          "has_runtime_result": false,
          "display_not_contains": ["Events completed"]
        }
      },
      {
        "text": "Accept defaults and build config.",
        "request": {"accept_defaults": true},
        "expect": {
          "dialogue_act_in": ["payload_draft_presented", "design_presented"],
          "has_payload": true,
          "has_runtime_result": false,
          "runtime_ready": false
        }
      }
    ]
  },
