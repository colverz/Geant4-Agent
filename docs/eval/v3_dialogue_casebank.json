  {
    "id": "v3-run-confirmation-gate",
    "lang": "en",
    "tags": ["confirmation", "runtime_guard"],
    "turns": [
      {
        "text": "Run a default lead shielding gamma simulation.",
        "request": {"accept_defaults": true, "run": true, "allow_in_memory": true},
        "expect": {
          "terminated_reason_in": ["waiting_confirmation"],
          "dialogue_act_in": ["action_needs_confirmation"],
          "has_pending_action": true,
          "runtime_ready": true,
          "phase": "await_confirmation"
        }
      },
      {
        "text": "Cancel run and keep the current design.",
        "expect": {
          "dialogue_act_in": ["action_cancelled"],
          "has_pending_action": false,
          "has_runtime_result": false
        }
      }
    ]
  },
  {
    "id": "v3-confirmed-run-observes-runtime",
    "lang": "en",
    "tags": ["confirmation", "runtime"],
    "turns": [
      {
        "text": "Run a default lead shielding gamma simulation.",
        "request": {"accept_defaults": true, "run": true, "allow_in_memory": true},
